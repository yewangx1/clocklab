<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:clocklab"
             x:Class="clocklab.MainPage"
             BackgroundColor="Black">
    <!--" подключаем стандартные эл. /служебные XAML по типу x:Class / Подключает собственный код из пространства имён clocklab-->

    <Grid ColumnDefinitions="2*, 1*" Padding="20">
        <!--сетка занимающая 2/3 ширины экрана / 1* 1/3 , * означает пропорционально остальному месту-->
        
        <local:ClockView Grid.Column="0" />
        <!--часы в левую сетку-->
        <local:ExtraFeaturesView Grid.Column="1" VerticalOptions="Center" />
        <!--модификации в правую сетку и делаем по центру-->
    </Grid>

</ContentPage>